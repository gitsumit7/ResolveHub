PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/resolvehub_db
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:5173

# ResolveHub settings
APP_NAME=ResolveHub
# The account registered with this email is the admin. Everyone else is a regular user.
ADMIN_EMAIL=sumitchaurasiya5154@gmail.com
# Target hours to resolve a ticket (used for the SLA / overdue metrics)
SLA_HOURS=48

# Optional: AI triage of category and priority
OPENAI_API_KEY=your_openai_api_key_here

# Gmail: enable 2-Step Verification and create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_gmail_app_password
SMTP_FROM=your_email@gmail.com
